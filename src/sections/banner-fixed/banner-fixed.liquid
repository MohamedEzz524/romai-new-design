{%- liquid
  assign s = section.settings
  assign tag = 'div'
  if s.link != blank
    assign tag = 'a'
  endif
-%}
<section
  class="banner-fixed banner-fixed--{{ s.height | default: 'short' }} banner-fixed--tone-{{ s.panel_tone | default: 'light' }}"
  data-section="banner-fixed"
  style="--banner-blur: {{ s.blur | default: 8 }}px; --banner-shade: {{ s.shade | default: 0.12 }};"
  aria-label="{{ s.heading | strip_html | escape }}"
>
  {%- comment -%} Fixed to the viewport, clipped to the section box: the page scrolls over it {%- endcomment -%}
  <div class="banner-fixed__media" aria-hidden="true">
    <picture>
      {%- if s.image_mobile != blank -%}
        <source media="(max-aspect-ratio: 9/10)" srcset="{{ s.image_mobile }}">
      {%- endif -%}
      <img src="{{ s.image }}" alt="" loading="lazy" decoding="async">
    </picture>
    <div class="banner-fixed__shade"></div>
  </div>

  <div class="banner-fixed__content">
    <{{ tag }} class="banner-fixed__panel"{% if s.link != blank %} href="{{ s.link }}"{% endif %}>
      <span class="banner-fixed__panel-blur" aria-hidden="true" data-reveal="stretch-y" data-reveal-duration="900" data-reveal-threshold="0.4"></span>
      {%- if s.caption != blank -%}
        <p class="banner-fixed__caption" data-reveal="fade" data-reveal-delay="1250" data-reveal-threshold="0.4">{{ s.caption }}</p>
      {%- endif -%}
      <h2 class="banner-fixed__title" data-reveal="chars-up" data-reveal-split="chars" data-reveal-delay="850" data-reveal-stagger="55" data-reveal-duration="1200" data-reveal-threshold="0.4">{{ s.heading }}</h2>
      {%- if s.cta_label != blank -%}
        <span class="banner-fixed__cta link" data-reveal="up" data-reveal-delay="1400" data-reveal-threshold="0.4">{{ s.cta_label }}</span>
      {%- endif -%}
    </{{ tag }}>
  </div>
</section>

{% schema %}
{
  "name": "Fixed image banner",
  "tag": "section",
  "class": "section-banner-fixed",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image (desktop)" },
    { "type": "image_picker", "id": "image_mobile", "label": "Image (portrait screens)" },
    { "type": "select", "id": "height", "label": "Section height", "default": "short", "options": [
      { "value": "short", "label": "Short band (1640:700 desktop, 320:400 phone)" },
      { "value": "full", "label": "Full screen" },
      { "value": "tall", "label": "80% of screen" },
      { "value": "medium", "label": "60% of screen" }
    ] },
    { "type": "range", "id": "shade", "label": "Darken image", "min": 0, "max": 0.6, "step": 0.02, "default": 0.12 },

    { "type": "header", "content": "Centre panel" },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fall '26" },
    { "type": "text", "id": "cta_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "select", "id": "panel_tone", "label": "Panel tone", "default": "light", "options": [
      { "value": "light", "label": "Light frost" },
      { "value": "dark", "label": "Dark frost" }
    ] },
    { "type": "range", "id": "blur", "label": "Frost blur (px)", "min": 0, "max": 40, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Fixed image banner" }]
}
{% endschema %}
