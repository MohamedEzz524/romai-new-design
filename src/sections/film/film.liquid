{%- liquid
  assign s = section.settings
-%}
<section class="film" data-section="film" style="--film-len: {{ s.scroll_length | default: 2.7 }};" aria-label="{{ s.heading | escape }}">
  <div class="film__head" data-reveal-group data-reveal-stagger="90">
    <div class="film__top">
      <p class="film__label" data-reveal="mask-up">{{ s.label }}</p>
      <div class="film__icons" data-reveal="mask-up" aria-hidden="true">
        <img src="{{ 'film/icon-1.svg' | asset_url }}" alt="" width="32" height="32">
        <img src="{{ 'film/icon-2.svg' | asset_url }}" alt="" width="32" height="32">
      </div>
    </div>
    <h2 class="film__heading" data-reveal="mask-up">
      {{ s.heading }}<img class="film__dot" src="{{ 'film/dot.webp' | asset_url }}" alt="" aria-hidden="true">
    </h2>
    <p class="film__text" data-reveal="up">{{ s.text }}</p>
  </div>

  <div class="film__track" data-film-track>
    <div class="film__pin">
      <a class="film__stage" href="{{ s.link }}" data-film-stage aria-label="{{ s.cursor_text | escape }}: {{ s.heading | escape }}">
        <span class="film__cursor" data-film-cursor aria-hidden="true"><b>[ </b>{{ s.cursor_text }}<b> ]</b></span>
        <video class="film__video" data-film-video muted loop playsinline preload="metadata" poster="{{ s.poster }}">
          <source src="{{ s.video }}" type="video/mp4">
        </video>
      </a>
      <p class="film__tip">{{ s.scroll_tip }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Film (vision in motion)",
  "tag": "section",
  "class": "section-film",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "07. Romai film" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A Vision in Motion" },
    { "type": "html", "id": "text", "label": "Text (<strong> = sand accent)" },
    { "type": "url", "id": "video", "label": "Video URL (.mp4)" },
    { "type": "image_picker", "id": "poster", "label": "Poster image" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "cursor_text", "label": "Cursor label", "default": "Discover" },
    { "type": "html", "id": "scroll_tip", "label": "Scroll tip" },
    { "type": "range", "id": "scroll_length", "label": "Pinned scroll length (screens)", "min": 1.5, "max": 5, "step": 0.1, "default": 2.7 }
  ],
  "presets": [{ "name": "Film (vision in motion)" }]
}
{% endschema %}
